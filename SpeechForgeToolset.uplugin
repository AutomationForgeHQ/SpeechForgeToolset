{
  "FileVersion": 3,
  "Version": 2,
  "VersionName": "0.2.2",
  "FriendlyName": "SpeechForge Toolset",
  "Description": "Exposes SpeechForge's pipeline as native Model Context Protocol tools, so an agent can author speech banks, price them, generate audio and manage graduation without a human driving the editor. Adapter only - it holds no pipeline logic and can be removed without affecting SpeechForge.",
  "Category": "Automation Forge",
  "CreatedBy": "Bojan Andrejek",
  "CreatedByURL": "https://kovati.dev",
  "DocsURL": "https://github.com/AutomationForgeHQ/SpeechForgeToolset",
  "MarketplaceURL": "",
  "SupportURL": "https://github.com/AutomationForgeHQ/SpeechForgeToolset/issues",
  "EditorOnly": true,
  "EnabledByDefault": false,
  "CanContainContent": false,
  "IsBetaVersion": false,
  "IsExperimentalVersion": true,
  "Installed": false,
  "Modules": [
    {
      "Name": "SpeechForgeToolset",
      "Type": "Editor",
      "LoadingPhase": "PostEngineInit",
      "TargetAllowList": [
        "Editor"
      ]
    }
  ],
  "Plugins": [
    {
      "Name": "SpeechForge",
      "Enabled": true
    },
    {
      "Name": "ToolsetRegistry",
      "Enabled": true
    },
    {
      "Name": "ModelContextProtocol",
      "Enabled": true
    }
  ]
}
